<!-- importa o header -->
<%- include('../partials/header') %>

<!-- MAIN : com o conteúdo da página-->
<main>
    <div class="container">
        <!-- Estilo do card geral -->
        <div class="card"
        style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); 
        background-color: var(--cor-fundo);">
            <!-- Texto inicial -->
            <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;"> 
                <i class="fa-solid fa-building"></i>
                CADASTRAR NOVA EMPRESA
            </h2>
            <!-- Formulário de cadastro -->
            <form action="/empresas/cadastrar" method="post">

                <div class="row">
                    <div class="col">
                        <fieldset>
                            <legend class="float-none w-auto"> <strong> Informações da empresa</strong> </legend>
                        </fieldset>

                        <div class="form-group">
                            <label for="nome">
                                <i class="fa-solid fa-id-card"></i> Nome da empresa:
                            </label>
                            <input type="text" id="nome" name="nome" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="email"> <i class="fa-solid fa-envelope"></i> Email:</label>
                            <input type="email" id="email" name="email" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="cnpj"> <i class="fa-solid fa-id-card"></i> CNPJ:</label>
                            <input type="text" id="cnpj" name="cnpj" class="form-control" maxlength="18" required>
                        </div>

                        <div class="form-group">
                            <label for="telefone">
                                <i class="fa-solid fa-phone"></i> Telefone / Whatsapp:
                            </label>
                            <input type="text" id="telefone" name="telefone" class="form-control" required>
                        </div>
                    </div>

                    <div class="col">
                        <fieldset>
                            <legend class="float-none w-auto text-white"> - </legend>
                        </fieldset>

                        <div class="form-group">
                            <label for="encarregado">
                                <i class="fa-solid fa-user"></i> Responsável:
                            </label>
                            <select name="encarregado" id="encarregado" class="form-control" required>
                                <option value="">Selecione</option>
                                <% if (usuarios && usuarios.length > 0) { %>
                                    <% usuarios.forEach(function(usuario) { %>
                                        <option value="<%= usuario.id %>"><%= usuario.nome %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="bairro">
                                <i class="fa-solid fa-home"></i> Bairro:
                            </label>
                            <input type="text" id="bairro" name="bairro" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="cidade">
                                <i class="fa-solid fa-city"></i> Cidade:
                            </label>
                            <input type="text" id="cidade" name="cidade" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="estado">
                                <i class="fa-solid fa-flag"></i> Estado:
                            </label>
                            <input type="text" id="estado" name="estado" class="form-control" required>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px;">
                    <i class="fa-solid fa-check"></i> Cadastrar
                </button>
            </form>
        </div>
    </div>
</main>

<!-- importa o footer -->
<%- include('../partials/footer') %>