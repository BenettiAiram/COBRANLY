<!-- importa o header -->
<%- include('../partials/header') %>

<!-- MAIN : com o conteúdo da página-->
<main>
    <div class="container">
        <!-- Estilo do card geral -->
        <div class="card"
        style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); 
        background-color: var(--cor-fundo);">
            <!-- Texto inicial -->
            <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;"> 
                <i class="fa-solid fa-user-plus"></i>
                CRIAR NOVO USUÁRIO
            </h2>
            <!-- Formulário de cadastro -->
            <form action="/usuarios/cadastrar" method="post" enctype="multipart/form-data">

                <div class="row">
                    <div class="col">
                        <fieldset>
                            <legend class="float-none w-auto"> <strong> Informações de login</strong> </legend>
                            
                        </fieldset>

                        <!-- Caixinha de nome -->
                         <div class="form-group">
                            <label for="nome">
                                <i class="fa-solid fa-id-card"></i> Nome da empresa:      
                            </label>
                            <input type="text" id="nome" name="nome" class="form-control" required>
                         </div>
                        
                         <!-- Caixinha de nome -->
                         <div class="form-group">
                            <label for="nome">
                                <i class="fa-solid fa-id-card"></i> Nome do encarregado:      
                            </label>
                            <input type="text" id="nome" name="nome" class="form-control" required>
                         </div>

                         <!-- Caixinha de CPF -->
                        <div class="form-group">
                            <label for="cpf"> <i class="fa-solid fa-id-card"></i> CPF (opcional)</label>
                            <input type="text" id="cpf" name="cpf" class="form-control" maxlength="11">
                        </div>

                        <!-- Caixinha de email -->
                        <div class="form-group">
                            <label for="email"> <i class="fa-solid fa-envelope"></i> Email:</label>
                            <input type="email" id="email" name="email" class="form-control" required>
                        </div>

                        <!-- Caixinha de perfil -->
                        <div class="form-group">
                            <label for="perfil"> <i class="fa-solid fa-users"></i> Papel do usuário:</label>
                            <select name="perfil" id="perfil" class="form-control" required>
                                <option value="none"> Selecione </option>
                                <option value="administrador"> Administrador </option>
                                <option value="cobrador"> Cobrador </option>
                            </select>
                        </div>

                        <!-- Caixinha de telefone -->
                         <div class="form-group">
                            <label for="telefone">
                                <i class="fa-solid fa-phone"></i> Telefone / Whatsapp:      
                            </label>
                            <input type="text" id="telefone" name="telefone" class="form-control" required>
                         </div>

                        <!-- Caixinha de foto -->
                        <div class="form-group">
                            <label for="foto"><i class="fa-solid fa-camera"></i> Foto da empresa</label>
                            <input type="file" name="foto" id="foto" class="form-control" accept="image/*" required>
                        </div>
                    </div>

                    <!-- SEGUNDA COLUNA -->
                    <div class="col">
                    <!-- Legenda divisão 1 -->
                        <fieldset>
                            <legend class="float-none w-auto text-white"> - </legend>
                        </fieldset>

                        <!-- Caixinha de senha -->
                         <div class="form-group"> 
                            <label for="senha"> <i class="fa-solid fa-lock"></i> Senha:</label>
                            <input type="password" name="senha" id="senha" class="form-control" required>
                         </div>

                         <!-- Caixinha de enderço -->
                         <div class="form-group">
                            <label for="endereco">
                                <i class="fa-solid fa-map-marker-alt"></i> Endereço:      
                            </label>
                            <input type="text" id="endereco" name="endereco" class="form-control" required>
                         </div>

                         <!-- Caixinha de bairro -->
                         <div class="form-group">
                            <label for="bairro">
                                <i class="fa-solid fa-home"></i> Bairro:      
                            </label>
                            <input type="text" id="bairro" name="bairro" class="form-control" required>
                         </div>

                         <!-- Caixinha de cidade -->
                         <div class="form-group">
                            <label for="cidade">
                                <i class="fa-solid fa-city"></i> Cidade:      
                            </label>
                            <input type="text" id="cidade" name="cidade" class="form-control" required>
                         </div>

                         <!-- Caixinha de estado -->
                         <div class="form-group">
                            <label for="estado">
                                <i class="fa-solid fa-flag"></i> Estado:      
                            </label>
                            <input type="text" id="estado" name="estado" class="form-control" required>
                         </div>

                         <!-- PREVIEW DA IMAGEM -->
                          <div id="preview-box" class="preview-container max-width:100%" style="height: 230px;">
                            <img src="..." alt="Foto da empresa" id="preview-img" style="height: 230px; width: auto;">
                          </div>
                    </div>
                </div>
                <!-- Botão de envio do formulário -->
                 <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px;">
                    <i class="fa-solid fa-check"></i> Cadastrar
                 </button>
            </form>
        </div>
    </div>
</main>

<!-- importa o footer -->
<%- include('../partials/footer') %>