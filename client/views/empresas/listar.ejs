<%- include('../partials/header') %>

<main class="container">
    <h2>Lista de usuarios</h2>

    <a href="/usuarios/cadastro" class="btn btn-primary">
        <i class="fa-solid fa-users-plus"></i> Novo usuario
    </a>

    <table class="tabela-dados border-ragius">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Perfil</th>
                <th>Acoes</th>
            </tr>
        </thead>
        <tbody>
            <% if (usuarios && usuarios.length > 0) { %>
                <% usuarios.forEach(function (user) { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.nome || '-' %></td>
                        <td><%= user.email %></td>
                        <td><%= user.perfil ? user.perfil.toUpperCase() : '-' %></td>
                        <td class="acoes-tabela">
                            <a href="/usuarios/editar/<%= user.id %>" class="btn btn-secondary">
                                <i class="fa-solid fa-pen"></i> Editar
                            </a>

                            <form action="/usuarios/deletar/<%= user.id %>" method="post"
                                  onsubmit="return confirm('Deseja realmente fazer a exclusao?')">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fa-solid fa-trash"></i> Excluir
                                </button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" class="tabela-vazia">Nenhum usuario cadastrado.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>

<%- include('../partials/footer') %>
