<!-- importa o header -->
<%- include('../partials/header') %>

<!-- MAIN : com o conteúdo da página-->
<main>
    <div class="container">
        <!-- Estilo do card geral -->
        <div class="card"
        style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); 
        background-color: var(--cor-fundo);">
            <!-- Texto inicial -->
            <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;"> 
                <i class="fa-solid fa-file-invoice-dollar"></i>
                CADASTRAR COBRANÇA
            </h2>
            <!-- Formulário de cadastro -->
            <form action="/cobrancas/cadastro" method="post">

                <div class="row">
                    <div class="col-12">
                        <fieldset>
                            <legend class="float-none w-auto"> Dados da cobrança </legend>
                        </fieldset>

                        <div class="form-group">
                            <label for="valor"> <i class="fa-solid fa-money-bill-wave"></i> Valor da dívida:</label>
                           <input type="number" step="0.01" id="valor" name="valor" class="form-control" required>
                        </div>

                        <div class="form-group mt-3">
                            <label for="status"> <i class="fa-solid fa-hourglass-half"></i> Status:</label>
                            <select name="status" id="status" class="form-control" required>
                                <option value="">Selecione</option>
                                <option value="pendente">Pendente</option>
                                <option value="atrasado">Atrasado</option>
                                <option value="pago">Pago</option>
                            </select>
                        </div>

                        <div class="form-group mt-3">
                            <label for="juros"> <i class="fa-solid fa-percent"></i> Juros:</label>
                            <input type="number" step="0.01" id="juros" name="juros" class="form-control" required>
                        </div>

                        <div class="form-group mt-3">
                            <label for="dataVencimento"> <i class="fa-solid fa-calendar-days"></i> Data de vencimento:</label>
                            <input type="date" id="dataVencimento" name="dataVencimento" class="form-control" required>
                        </div>

                        <div class="form-group mt-3">
                            <label for="empresaId"> <i class="fa-solid fa-building"></i> Empresa:</label>
                            <select name="empresaId" id="empresaId" class="form-control" required>
                                <option value="">Selecione</option>
                                <% if (empresas && empresas.length > 0) { %>
                                  <% empresas.forEach(function (empresa) { %>
                                    <option value="<%= empresa.id %>"><%= empresa.nome %></option>
                                  <% }) %>
                                <% } %>
                            </select>
                        </div>

                        <div class="form-group mt-3">
                            <label for="usuarioId"> <i class="fa-solid fa-user"></i> Devedor:</label>
                            <select name="usuarioId" id="usuarioId" class="form-control" required>
                                <option value="">Selecione</option>
                                <% if (devedores && devedores.length > 0) { %>
                                  <% devedores.forEach(function (devedor) { %>
                                    <option value="<%= devedor.id %>"><%= devedor.nome %></option>
                                  <% }) %>
                                <% } %>
                            </select>
                        </div>
                    </div>
                </div>
                <!-- Botão de envio do formulário -->
                 <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px;">
                    <i class="fa-solid fa-check"></i> Cadastrar
                 </button>
            </form>
        </div>
    </div>
</main>

<!-- importa o footer -->
<%- include('../partials/footer') %>