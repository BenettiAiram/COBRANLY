<%- include('../partials/header') %>

<main>
    <div class="container">
        <div class="card"
             style="padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-fundo);">
            <h2 style="color: var(--cor-destaque); text-align: center; margin-bottom: 5px;">
                <i class="fa-solid fa-file-invoice-dollar"></i>
                EDITAR COBRANÇA
            </h2>
            <form action="/cobrancas/atualizar/<%= cobranca.id %>" method="post">
                <div class="row">
                    <div class="col-12">
                        <fieldset>
                            <legend class="float-none w-auto">Dados da cobrança</legend>
                        </fieldset>

                        <div class="form-group">
                            <label for="valor"> <i class="fa-solid fa-money-bill-wave"></i> Valor da dívida:</label>
                            <input type="text" id="valor" name="valor" class="form-control" value="<%= cobranca.valor %>" required>
                        </div>

                        <div class="form-group mt-3">
                            <label for="status"> <i class="fa-solid fa-hourglass-half"></i> Status:</label>
                            <select name="status" id="status" class="form-control" required>
                                <option value="">Selecione</option>
                                <option value="pendente" <%= cobranca.status === 'pendente' ? 'selected' : '' %>>Pendente</option>
                                <option value="atrasado" <%= cobranca.status === 'atrasado' ? 'selected' : '' %>>Atrasado</option>
                                <option value="pago" <%= cobranca.status === 'pago' ? 'selected' : '' %>>Pago</option>
                            </select>
                        </div>

                        <div class="form-group mt-3">
                            <label for="juros"> <i class="fa-solid fa-percent"></i> Juros:</label>
                            <input type="text" id="juros" name="juros" class="form-control" value="<%= cobranca.juros %>" required>
                        </div>

                        <div class="form-group mt-3">
                            <label for="dataVencimento"> <i class="fa-solid fa-calendar-days"></i> Data de vencimento:</label>
                            <input type="date" id="dataVencimento" name="dataVencimento" class="form-control" value="<%= cobranca.dataVencimento %>" required>
                        </div>

                        <div class="form-group mt-3">
                            <label for="empresaId"> <i class="fa-solid fa-building"></i> Empresa:</label>
                            <select name="empresaId" id="empresaId" class="form-control" required>
                                <option value="">Selecione</option>
                                <% empresas.forEach(function (empresa) { %>
                                  <option value="<%= empresa.id %>" <%= empresa.id === cobranca.empresaId ? 'selected' : '' %>><%= empresa.nome %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group mt-3">
                            <label for="usuarioId"> <i class="fa-solid fa-user"></i> Devedor:</label>
                            <select name="usuarioId" id="usuarioId" class="form-control" required>
                                <option value="">Selecione</option>
                                <% devedores.forEach(function (devedor) { %>
                                  <option value="<%= devedor.id %>" <%= devedor.id === cobranca.usuarioId ? 'selected' : '' %>><%= devedor.nome %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-secondary" style="width: 100%; margin-top: 15px;">
                    <i class="fa-solid fa-floppy-disk"></i> SALVAR ALTERAÇÕES
                </button>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
