<!-- importa o header -->
<%- include('../partials/header') %>

<!-- MAIN: Centraliza o card no espaço livre, igual ao login -->
<main class="login-container">
    <!-- CARD DE RECUPERAÇÃO: mesmo Design System Brutalista do login -->
    <div class="card" style="width: 100%; max-width: 400px; padding: 2rem; border: 2px solid var(--cor-borda); box-shadow: 6px 6px 0px var(--cor-borda); background-color: var(--cor-padrao);">
        <div style="text-align: center; margin-bottom: 2rem;">
            <!-- Ícone de cadeado aberto, mesma escala do login -->
            <i class="fa-solid fa-lock-open fa-4x" style="color: var(--cor-destaque); margin-bottom: 10px;"></i>
            <h2 style="margin: 0;">Recuperar Senha</h2>
            <p style="color: var(--cor-texto-secundario); margin-top: 5px;">Informe seu e-mail e enviaremos um link para redefinir sua senha.</p>
        </div>

        <!-- Flash de erro -->
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-exclamation"></i> <%= error %>
        </div>
        <% } %>

        <!-- Flash de sucesso -->
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" style="margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-check"></i> <%= success %>
        </div>
        <% } %>

        <!-- Formulário apontando para a rota de recuperação de senha -->
        <form action="/usuarios/recuperar_senha" method="POST">

            <!-- CSRF token (caso use csurf ou similar) -->
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } %>

            <div class="form-group">
                <label for="email_recuperacao">
                    <i class="fa-solid fa-envelope"></i> E-mail
                </label>
                <input
                    type="email"
                    id="email_recuperacao"
                    name="email"
                    class="form-control"
                    placeholder="Seu e-mail cadastrado"
                    value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
                    required
                    autofocus
                >
            </div>

            <!-- Botão de envio -->
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px; font-size: 16px;">
                <i class="fa-solid fa-paper-plane"></i> Enviar link de recuperação
            </button>

            <!-- Link de volta ao login -->
            <div style="text-align: center; margin-top: 25px;">
                <a href="/usuarios/login" style="color: var(--cor-texto-principal); font-weight: bold; text-decoration: none;">
                    Lembrou a senha? <span style="color: var(--cor-destaque); text-decoration: underline;">Voltar ao login</span>
                </a>
            </div>

        </form>
    </div>
</main>

<!-- importa o footer -->
<%- include('../partials/footer') %>
